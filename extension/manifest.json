{
  "manifest_version": 3,
  "name": "Feedpipe Injector",
  "version": "2.0",
  "description": "Добавить текущий сайт в Feedpipe RSS",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "../static/favicon.svg"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}